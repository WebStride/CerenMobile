APP_ENV=production
EXPO_PUBLIC_API_URL=EXPO_PUBLIC_API_URL
# Maps SDK (required for APK/IPA map tiles — not just geocoding in JS):
# Local: copy to .env.production or .env
# EAS:  eas env:create --name EXPO_GOOGLE_MAPS_API_KEY --value YOUR_ANDROID_KEY --environment production
#       eas env:create --name EXPO_GOOGLE_MAPS_API_KEY_IOS --value YOUR_IOS_KEY --environment production
#       (same names for preview environment if you use preview builds)
EXPO_GOOGLE_MAPS_API_KEY=EXPO_GOOGLE_MAPS_API_KEY
EXPO_GOOGLE_MAPS_API_KEY_IOS=EXPO_GOOGLE_MAPS_API_KEY_IOS
EXPO_PUBLIC_INTEGRATED_NO=EXPO_PUBLIC_INTEGRATED_NO
EXPO_PUBLIC_MSG91_AUTH_KEY=EXPO_PUBLIC_MSG91_AUTH_KEY
EXPO_PUBLIC_ADMIN_TO_NUMBER=EXPO_PUBLIC_ADMIN_TO_NUMBER
EXPO_PUBLIC_MSG91_WHATSAPP_URL=EXPO_PUBLIC_MSG91_WHATSAPP_URL

