{
  "expo": {
    "name": "Ceren",
    "slug": "mobileappui",
    "version": "1.0.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "backgroundColor": "#BCD042",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "ceren",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "projectId": "4723d436-4ca1-433e-91dc-708913375cfa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceren.ceren",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#BCD042"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ceren.ceren",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#BCD042"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4723d436-4ca1-433e-91dc-708913375cfa"
      }
    }
  }
}
